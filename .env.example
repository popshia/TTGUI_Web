# Flask
FLASK_APP=app.py
FLASK_ENV=development
# Generate a strong random key for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me
# Max upload size in bytes (default: 10 GB)
MAX_CONTENT_LENGTH=10737418240

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
# Set to your public-facing URL in production (used in email download links)
SERVER_URL=http://127.0.0.1:5000

# Gmail SMTP
# Requires a Gmail App Password (not your account password).
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_USER=clink.tap.service@gmail.com
SMTP_PASSWORD=mail smtp pass word

# Inbox that receives "Contact Us" form submissions.
# Defaults to SMTP_USER if not set.
CONTACT_RECIPIENT=clink.tap.service@gmail.com

# Maximum analyze seconds for free tier users
FREE_TIER_MAX_DURATION_SECONDS=300
